{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MOD0",
    "version": "0.3.0",
    "identifier": "com.luke.mod0",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "MOD0",
                "width": 1440,
                "height": 900,
                "minWidth": 960,
                "minHeight": 600,
                "center": true,
                "resizable": true,
                "decorations": false,
                "transparent": false,
                "shadow": true,
                "backgroundColor": "#0e1013"
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
            "capabilities": ["main-capability"]
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis", "appimage", "deb", "dmg"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "category": "DeveloperTool",
        "shortDescription": "Mission control para tus sesiones de CLI con IA",
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "compression": "lzma",
                "displayLanguageSelector": false,
                "languages": ["Spanish", "English"],
                "installerIcon": "icons/icon.ico",
                "headerImage": "installer/header.bmp",
                "sidebarImage": "installer/sidebar.bmp"
            }
        }
    }
}
